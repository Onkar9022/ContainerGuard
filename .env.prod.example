# ============================================================
# ContainerGuard — Production Environment Variables Template
# ============================================================
# Copy this file to .env.prod when launching the production stack:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# DO NOT commit .env.prod containing production secrets to git.
# ============================================================

# Database Credentials
POSTGRES_USER=containerguard
POSTGRES_PASSWORD=SetAStrongProductionPasswordHere!
POSTGRES_DB=containerguard

# PostgreSQL Data Volume Name
# Set to 'containerguard-postgres-data' to reuse existing database volume from previous stack,
# or 'containerguard-prod-postgres-data' for isolated production volume.
POSTGRES_VOLUME_NAME=containerguard-postgres-data

# Production Gateway Port (Host port exposed for Nginx)
PROD_HTTP_PORT=8080

# Frontend API Target (Leave empty for same-origin reverse-proxying via Nginx /api)
VITE_API_URL=

# Alert System Configuration (Phase 14)
CPU_ALERT_THRESHOLD_PERCENT=80
MEMORY_ALERT_THRESHOLD_PERCENT=80
POLICY_ALERT_SCORE_THRESHOLD=70
RESTART_LOOP_THRESHOLD=3
RESTART_LOOP_WINDOW_SECONDS=300
ALERT_EVALUATION_INTERVAL_MS=10000

# ============================================================
# Immutable SHA-Based Image Deployment (Phase 18)
# ============================================================
# For ECR production deployment, set these to the exact
# commit SHA images pushed by GitHub Actions.
#
# IMPORTANT: Do NOT use ":latest" for production deployments.
# Always use the full Git commit SHA for immutability.
#
# Format:
#   <account-id>.dkr.ecr.<region>.amazonaws.com/<repo>:<commit-sha>
#
# Example:
#   BACKEND_IMAGE=461415799543.dkr.ecr.ap-south-1.amazonaws.com/containerguard-backend:abc123def456
#   FRONTEND_IMAGE=461415799543.dkr.ecr.ap-south-1.amazonaws.com/containerguard-frontend:abc123def456
#
# For local development, leave these unset to use local build context.
# BACKEND_IMAGE=
# FRONTEND_IMAGE=
