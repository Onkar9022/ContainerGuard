# ============================================================
# ContainerGuard Backend — Docker Environment Variables
# ============================================================
# This file documents the environment variables the backend
# container needs when running inside Docker Compose.
#
# DO NOT put real passwords in this file.
# Docker Compose will supply these values to the container
# through the "environment" or "env_file" directive.
# ============================================================

# ------------------------------------
# Server
# ------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------
# Database (PostgreSQL container)
# ------------------------------------
# IMPORTANT:
#   "postgres" = the Docker Compose service name for the PostgreSQL container.
#   Inside Docker's internal network, containers reach each other by service name.
#   Do NOT use "localhost" here — localhost inside the backend container
#   refers to the backend container itself, not the PostgreSQL container.
#
#   5432 = the default PostgreSQL port inside the container.
#   "containerguard" = the database name (you choose this).
#
DATABASE_URL="postgresql://containerguard:YOUR_PASSWORD@postgres:5432/containerguard"

# ------------------------------------
# CORS
# ------------------------------------
# When running the frontend through Nginx in the same Docker network,
# the frontend is served from the same origin, so CORS may not be needed.
# For development with the frontend running outside Docker:
CORS_ORIGIN=http://localhost:5173

# ------------------------------------
# Docker Engine (Phase 4)
# ------------------------------------
# The Docker socket is mounted into the backend container as a volume.
# DOCKER_SOCKET=/var/run/docker.sock
