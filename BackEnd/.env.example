# ============================================================
# ContainerGuard Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env files with real credentials.
# ============================================================

# ------------------------------------
# Server
# ------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------
# Database (PostgreSQL)
# ------------------------------------
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
#
# For local non-Docker development (e.g. Neon, Supabase, local PostgreSQL):
#   DATABASE_URL="postgresql://user:password@your-host.neon.tech/your-database?sslmode=require"
#
# For Docker development (PostgreSQL container):
#   DATABASE_URL="postgresql://containerguard:your_password@postgres:5432/containerguard"
#   Note: "postgres" is the Docker Compose service name, NOT localhost.
#
DATABASE_URL="postgresql://username:password@host:5432/database"

# ------------------------------------
# CORS
# ------------------------------------
CORS_ORIGIN=http://localhost:5173

# ------------------------------------
# Docker Engine (Phase 4)
# ------------------------------------
# DOCKER_SOCKET=/var/run/docker.sock

# ------------------------------------
# Trivy Security Scanner (Phase 11)
# ------------------------------------
# TRIVY_PATH=/usr/local/bin/trivy

# ------------------------------------
# Metrics collection interval in ms (Phase 8)
# ------------------------------------
# METRICS_INTERVAL=15000
