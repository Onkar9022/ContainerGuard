generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContainerMetric {
  id              String   @id @default(cuid())
  containerId     String
  timestamp       DateTime
  cpuPercent      Float
  memoryUsage     Float
  memoryLimit     Float
  memoryPercent   Float
  networkRxBytes  Float
  networkTxBytes  Float
  blockReadBytes  Float
  blockWriteBytes Float

  @@index([containerId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("container_metrics")
}

model SecurityScan {
  id                   String          @id @default(cuid())
  image                String
  imageId              String?
  scanTimestamp        DateTime        @default(now())
  status               String
  
  criticalCount        Int             @default(0)
  highCount            Int             @default(0)
  mediumCount          Int             @default(0)
  lowCount             Int             @default(0)
  unknownCount         Int             @default(0)
  totalVulnerabilities Int             @default(0)
  
  createdAt            DateTime        @default(now())
  
  vulnerabilities      Vulnerability[]

  @@index([image, scanTimestamp(sort: Desc)])
  @@index([image])
  @@map("security_scans")
}

model Vulnerability {
  id               String       @id @default(cuid())
  scanId           String
  scan             SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  
  vulnerabilityId  String
  packageName      String
  installedVersion String
  fixedVersion     String?
  severity         String
  title            String?
  description      String?
  primaryUrl       String?
  target           String?

  @@index([scanId])
  @@index([severity])
  @@index([vulnerabilityId])
  @@map("vulnerabilities")
}

model Alert {
  id            String    @id @default(cuid())
  alertCode     String
  containerId   String
  containerName String
  severity      String    // CRITICAL, WARNING, NOTICE
  status        String    // OPEN, ACKNOWLEDGED, RESOLVED
  title         String
  message       String
  source        String    // METRICS, DOCKER, SECURITY, POLICY
  metadata      Json?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([alertCode, containerId, status])
  @@index([containerId])
  @@map("alerts")
}

