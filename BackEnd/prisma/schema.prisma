generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContainerMetric {
  id            String   @id @default(cuid())
  containerId   String
  containerName String
  cpuUsage      Float
  memoryUsage   Float
  memoryLimit   Float
  networkRx     Float
  networkTx     Float
  pids          Int      @default(0)
  timestamp     DateTime @default(now())

  @@index([containerId])
  @@index([timestamp])
  @@map("container_metrics")
}
